# Copy to .env to override defaults.
API_PORT=8000
# "cpu" works everywhere out of the box; use "cuda:0" if you built the
# image with a CUDA-enabled torch wheel and have a GPU available.
MMDET_DEVICE=cpu
# Max size of an uploaded video, in MiB. Uploads over this are rejected
# (HTTP 413) before being fully written to disk.
MAX_UPLOAD_MB=2048
