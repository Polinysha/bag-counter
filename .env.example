# Copy to .env to override defaults.
API_PORT=8000
# "cpu" works everywhere out of the box; use "cuda:0" if you built the
# image with a CUDA-enabled torch wheel and have a GPU available.
MMDET_DEVICE=cpu
# Max size of an uploaded video, in MiB. Uploads over this are rejected
# (HTTP 413) before being fully written to disk.
MAX_UPLOAD_MB=2048
# Shared API key required as an X-API-Key header on every /api/v1/*
# request. Leave unset for local/demo use (auth disabled - a startup
# warning is logged). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Postgres instead of the SQLite default. Leave unset to keep using
# SQLite (zero extra setup). Only takes effect if you also run with
# docker-compose.postgres.yml (see that file) - these three just
# parameterize its connection string:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up --build
POSTGRES_USER=bagcounter
POSTGRES_PASSWORD=bagcounter
POSTGRES_DB=bagcounter
